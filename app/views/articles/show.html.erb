<h2><%= @article.title %></h2>
<p><%= @article.content %></p>
<br>
<p><b>Author:</b><%= @user.name %><br>
<h3>Comments</h3>
<% if @blogcomment.any? %>
    <ul>
        <% @blogcomment.each do |comment| %>
            <li><%= comment.content %> - <%= comment.created_at.strftime("%d %b %Y") %></li>
            <%= button_to "del", [@article,comment], method: :delete if user_signed_in? &&  comment.user_id == current_user.id %>
        <% end %>
    </ul>
<% else %>
    <p>No comments yet.</p>
<% end %>
<% if user_signed_in? %>
    <%= form_with model: [@article, @comment] do |form| %>
        <h2>Write your content here</h2><br>
        <%= form.text_area(:content, size: '150x10') %>
        <%= form.submit %>
    <% end %>
<% else %>
    <h2>Please log in in to comment </h2>
<% end %>
<%= link_to "Edit", edit_article_path(@article) if @user == current_user %><br>
<%= link_to "Back", user_path(@user) %><br>
<%= button_to "Delete", @article, method: :delete if @user == current_user %>
