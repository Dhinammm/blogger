<h2><%= @article.title %></h2>
<p><%= @article.content %></p>
<br>
<p><b>Author:</b><%= @user.name %><br>
<%= link_to "Edit", edit_article_path(@article) if @user == current_user %><br>
<%= link_to "Back", user_path(@user) %><br>
<%= button_to "Delete", @article, method: :delete if @user == current_user %>
