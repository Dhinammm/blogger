<h1>Welcome to Articles page</h1>
<% if user_signed_in? %>
    <%= link_to "New article", user_path(current_user) %>
<% else %>
    <%= link_to "New article", new_user_session_path %>
<% end %><br>
<% @article&.each do |article| %>
    <a href="/articles/<%= article.id %>">
      <%= article.title %>
      <br>
    </a>
<% end %><br>
<a href = "/users">View users<a><br>
<%= link_to "Sign up", new_user_registration_path %>
<br>
